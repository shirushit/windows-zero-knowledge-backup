<Window x:Class="BackupApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupApp.UI.ViewModels"
        mc:Ignorable="d"
        Title="גיבוי ושחזור מאובטח באפס-ידע"
        Height="680" Width="920"
        MinHeight="550" MinWidth="750"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Content Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="גיבוי מאובטח ואפס-ידע" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="הצפנה מקומית XChaCha20-Poly1305 ומפתחות בלעדיים למשתמש" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌓 ערכת נושא"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.Name="החלף ערכת נושא תצוגה"
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="16,10,16,10">

            <!-- TAB 1: STATUS & BACKUP -->
            <TabItem Header="_1. סטטוס וגיבוי" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="לשונית סטטוס וגיבוי">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,15,0,0" MaxWidth="720" HorizontalAlignment="Center">
                        <!-- Protection State Card -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="48" Height="48" Fill="{DynamicResource AppSuccessBrush}" VerticalAlignment="Top" Margin="0,4,16,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatusSubtitle}" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,12"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="מוגן לאחרונה:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="סה&quot;כ קבצים:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalFilesCount}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="נפח גיבוי:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Progress Section (Visible when busy) -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="הפעולה מתבצעת כעת..." FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppAccentBrush}"/>
                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,10,0,8"/>
                                <Grid>
                                    <TextBlock Text="{Binding CurrentProgressItem}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    <TextBlock Text="{Binding ProgressSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding HasSpeedOrEta, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="⚡ מהירות: " FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentSpeedFormatted}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,16,0"/>
                                        <TextBlock Text="⏳ זמן משוער: " FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding EtaFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="בטל פעולה"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelOperationCommand}"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Button -->
                        <Button Content="🚀 הפעל גיבוי עכשיו"
                                Command="{Binding TriggerBackupCommand}"
                                FontSize="16"
                                Padding="24,12"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                AutomationProperties.Name="כפתור הפעלת גיבוי עכשיו"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BROWSE & SEARCH -->
            <TabItem Header="_2. עיון וחיפוש" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="לשונית עיון וחיפוש קבצים">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 FontSize="13"
                                 Background="{DynamicResource AppSurfaceBrush}"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 AutomationProperties.Name="תיבת חיפוש קבצים"/>
                        <TextBlock Grid.Column="0" Text="🔍 חפש לפי שם קובץ או נתיב..."
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Margin="12,8,0,0"
                                   Visibility="{Binding IsSearchQueryEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Action Bar for Selected File -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="קובץ נבחר: " FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedFile.FormattedPath, FallbackValue='(לא נבחר קובץ)'}"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="380"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="👁️ פתח קובץ"
                                        Command="{Binding OpenSelectedFileCommand}"
                                        CommandParameter="{Binding SelectedFile}"
                                        ToolTip="שחזר קובץ זה זמנית ופתח אותו בתוכנת ברירת המחדל של Windows (או לחיצה כפולה על השורה)"
                                        AutomationProperties.Name="פתח קובץ לצפייה"
                                        Margin="0,0,8,0"
                                        Padding="12,6"
                                        FontSize="12"/>
                                <Button Content="📥 שחזר קובץ זה"
                                        Command="{Binding RestoreSingleFileCommand}"
                                        CommandParameter="{Binding SelectedFile}"
                                        ToolTip="שחזר קובץ זה אל תיקיית היעד"
                                        AutomationProperties.Name="שחזר קובץ יחיד"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Padding="12,6"
                                        FontSize="12"/>
                                <Button Content="🕒 היסטוריית גרסאות"
                                        Command="{Binding ShowFileVersionsCommand}"
                                        CommandParameter="{Binding SelectedFile}"
                                        ToolTip="הצג את כל הגרסאות הקודמות של הקובץ הנבחר עם תאריכי הגיבוי שלהן"
                                        AutomationProperties.Name="היסטוריית גרסאות"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Padding="12,6"
                                        FontSize="12"/>
                                <Button Content="📁 הצג בתיקייה"
                                        Command="{Binding ShowFileInFolderCommand}"
                                        CommandParameter="{Binding SelectedFile}"
                                        ToolTip="הצג את הקובץ בסייר הקבצים של Windows"
                                        AutomationProperties.Name="הצג בסייר הקבצים"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: File List -->
                        <ListView Grid.Column="0"
                                  ItemsSource="{Binding BrowsedFiles}"
                                  SelectedItem="{Binding SelectedFile}"
                                  Background="{DynamicResource AppSurfaceBrush}"
                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                  Foreground="{DynamicResource AppTextPrimaryBrush}"
                                  AutomationProperties.Name="רשימת קבצים מגובים"
                                  Margin="0,0,10,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemMouseDoubleClick"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu FlowDirection="RightToLeft">
                                                <MenuItem Header="👁️ פתח קובץ (שחזר וצפה)"
                                                          Command="{Binding DataContext.OpenSelectedFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                          CommandParameter="{Binding}"
                                                          FontWeight="SemiBold"/>
                                                <MenuItem Header="🕒 היסטוריית גרסאות"
                                                          Command="{Binding DataContext.ShowFileVersionsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="📁 הצג בתיקייה (Explorer)"
                                                          Command="{Binding DataContext.ShowFileInFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="📥 שחזר קובץ זה"
                                                          Command="{Binding DataContext.RestoreSingleFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="נתיב הקובץ" Width="260" DisplayMemberBinding="{Binding FormattedPath}"/>
                                    <GridViewColumn Header="גודל" Width="90" DisplayMemberBinding="{Binding FormattedSize}"/>
                                    <GridViewColumn Header="תאריך שינוי" Width="130" DisplayMemberBinding="{Binding FormattedDate}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Right: File Preview & Metadata Panel -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid>
                                <!-- No file selected state -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasNoSelectedFile, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                    <TextBlock Text="בחר קובץ מהרשימה" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="לצפייה בפרטים, תמונות ותוכן טקסט" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- File selected preview content -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="תצוגה מקדימה ומטא-דאטה" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,8"/>

                                        <!-- Metadata Card -->
                                        <Border Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedFile.FormattedPath}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="גודל:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding SelectedFile.FormattedSize}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="תאריך שינוי:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding SelectedFile.FormattedDate}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="מקטעים (Chunks):" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding SelectedFile.ChunkCount}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="SHA-256:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding SelectedFile.ShortHash}" ToolTip="{Binding SelectedFile.ContentHashSha256}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Image Preview (for graphic files) -->
                                        <Border Visibility="{Binding IsImagePreview, Converter={StaticResource BoolToVis}}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                                                Background="{DynamicResource AppBackgroundBrush}" Padding="4" Margin="0,0,0,10">
                                            <Image Source="{Binding PreviewImagePath}" MaxHeight="180" Stretch="Uniform"/>
                                        </Border>

                                        <!-- Text Preview (for txt, json, code, md) -->
                                        <Border Visibility="{Binding IsTextPreview, Converter={StaticResource BoolToVis}}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6"
                                                Background="{DynamicResource AppBackgroundBrush}" Padding="6" Margin="0,0,0,10">
                                            <TextBox Text="{Binding PreviewTextContent}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     FontFamily="Consolas, Segoe UI"
                                                     FontSize="10.5"
                                                     MaxHeight="180"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Secondary Panel: Version History for Selected File -->
                    <Border Grid.Row="3"
                            Visibility="{Binding IsVersionHistoryVisible, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,10,0,0"
                            MaxHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒 היסטוריית גרסאות עבור: " FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedFile.FormattedPath}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="📥 שחזר גרסה זו"
                                            Command="{Binding RestoreSelectedVersionCommand}"
                                            CommandParameter="{Binding SelectedVersion}"
                                            IsEnabled="{Binding HasSelectedVersion}"
                                            ToolTip="שחזר את הגרסה שנבחרה אל תיקיית היעד"
                                            AutomationProperties.Name="שחזר גרסה נבחרת"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            FontSize="12"/>
                                    <Button Content="✕ סגור"
                                            Command="{Binding CloseVersionHistoryCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="סגור חלונית גרסאות"
                                            AutomationProperties.Name="סגור חלונית גרסאות"
                                            Padding="10,6"
                                            FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding SelectedFileVersions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      MaxHeight="180"
                                      Background="{DynamicResource AppBackgroundBrush}"
                                      BorderBrush="{DynamicResource AppBorderBrush}"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      AutomationProperties.Name="רשימת גרסאות קובץ">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu FlowDirection="RightToLeft">
                                                    <MenuItem Header="📥 שחזר גרסה זו"
                                                              Command="{Binding DataContext.RestoreSelectedVersionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                              CommandParameter="{Binding}"
                                                              FontWeight="SemiBold"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="גרסה" Width="100" DisplayMemberBinding="{Binding SnapshotLabel}"/>
                                        <GridViewColumn Header="תאריך גיבוי" Width="160" DisplayMemberBinding="{Binding BackupDateFormatted}"/>
                                        <GridViewColumn Header="תאריך שינוי קובץ" Width="160" DisplayMemberBinding="{Binding ModifiedDateFormatted}"/>
                                        <GridViewColumn Header="גודל" Width="100" DisplayMemberBinding="{Binding FormattedSize}"/>
                                        <GridViewColumn Header="SHA-256 Hash" Width="160" DisplayMemberBinding="{Binding ShortHash}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: RESTORE -->
            <TabItem Header="_3. שחזור נתונים" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="לשונית שחזור נתונים">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,15,0,0" MaxWidth="720" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="שחזור נתונים מאומת (Disaster Recovery)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="כל הקבצים מורדים מהאחסון המרוחק, מוודאים אותנטיות ב-Poly1305 וחותמת זמן מקורית." FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,16"/>

                                <TextBlock Text="נקודת זמן לשחזור (Point-in-Time Restore):" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableSnapshots}"
                                          SelectedItem="{Binding SelectedSnapshot}"
                                          DisplayMemberPath="DisplayText"
                                          Padding="10,8"
                                          FontSize="13"
                                          Margin="0,0,0,16"
                                          AutomationProperties.Name="בחירת נקודת זמן לשחזור"/>

                                <TextBlock Text="תיקיית יעד לשחזור:" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding RestoreDestination, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="10,8"
                                             FontSize="13"
                                             Background="{DynamicResource AppSurfaceBrush}"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                             BorderBrush="{DynamicResource AppBorderBrush}"
                                             AutomationProperties.Name="נתיב תיקיית יעד לשחזור"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📁 עיון..." Command="{Binding BrowseRestoreDestinationCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            AutomationProperties.Name="עיון לבחירת תיקיית יעד לשחזור"
                                            ToolTip="בחר תיקיית יעד לשחזור באמצעות חלון המערכת"
                                            Margin="8,0,0,0"
                                            Padding="16,8"/>
                                </Grid>

                                <TextBlock Text="מדיניות התנגשות קבצים:" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton Content="דרוס קבצים קיימים" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,20,0"/>
                                    <RadioButton Content="שנה שם לקובץ קיים" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,20,0"/>
                                    <RadioButton Content="דלג על קבצים קיימים" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </StackPanel>

                                <CheckBox Content="שחזר חותמות זמן מקוריות (תאריך יצירה ושינוי)"
                                          IsChecked="{Binding RestoreTimestamps}"
                                          Foreground="{DynamicResource AppTextPrimaryBrush}"
                                          Margin="0,0,0,20"/>

                                <Button Content="📥 התחל שחזור מלא עכשיו"
                                        Command="{Binding TriggerRestoreCommand}"
                                        FontSize="15"
                                        Padding="20,10"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="כפתור התחל שחזור מלא"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Progress Section in Restore Tab (Visible when busy) -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="תהליך שחזור נתונים מתבצע כעת..." FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppAccentBrush}"/>
                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,10,0,8"/>
                                <Grid>
                                    <TextBlock Text="{Binding CurrentProgressItem}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                    <TextBlock Text="{Binding ProgressSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Button Content="בטל שחזור"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelOperationCommand}"
                                        HorizontalAlignment="Right"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Restore Status / Completion Card -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasRestoreStatusMessage, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RestoreStatusMessage}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRestoreError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="📂 פתח תיקיית שחזור"
                                        Command="{Binding OpenRestoreFolderCommand}"
                                        Visibility="{Binding IsRestoreCompleted, Converter={StaticResource BoolToVis}}"
                                        FontSize="14"
                                        Padding="18,9"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="כפתור פתח תיקיית שחזור"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: SETTINGS -->
            <TabItem Header="_4. הגדרות" FontSize="14" FontWeight="SemiBold" AutomationProperties.Name="לשונית הגדרות">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,15,0,0" MaxWidth="720" HorizontalAlignment="Center">
                        <!-- Included Roots -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="תיקיות מיועדות לגיבוי" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="כל התיקיות והקבצים תחת נתיבים אלו ייכללו בסריקה ובגיבוי המוצפן." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,12"/>

                                <ItemsControl ItemsSource="{Binding IncludedRoots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding}"
                                                               FlowDirection="LeftToRight"
                                                               HorizontalAlignment="Left"
                                                               FontSize="13"/>
                                                    <Button Grid.Column="1"
                                                            Content="✕ הסר"
                                                            ToolTip="הסר תיקייה זו מרשימת הגיבוי"
                                                            AutomationProperties.Name="הסר תיקייה"
                                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#1AEF4444"
                                                            Foreground="#DC2626"
                                                            BorderBrush="#DC2626"
                                                            BorderThickness="1"
                                                            Padding="10,4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Cursor="Hand"
                                                            Margin="10,0,0,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewRootPath, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" FontSize="12"
                                             Background="{DynamicResource AppSurfaceBrush}"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                             BorderBrush="{DynamicResource AppBorderBrush}"
                                             AutomationProperties.Name="נתיב תיקייה חדשה להוספה"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📁 עיון..." Command="{Binding BrowseFolderCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            AutomationProperties.Name="עיון לבחירת תיקייה"
                                            ToolTip="בחר תיקייה לגיבוי באמצעות חלון המערכת"
                                            Margin="8,0,0,0"
                                            Padding="14,6"/>
                                    <Button Grid.Column="2" Content="הוסף תיקייה" Command="{Binding AddFolderCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            AutomationProperties.Name="הוסף תיקייה לרשימה"
                                            Margin="8,0,0,0"
                                            Padding="14,6"/>
                                </Grid>
                                <TextBlock Text="{Binding SettingsStatusMessage}" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Automatic Scheduling & Background Monitoring -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⏰ תזמון וגיבוי אוטומטי ברקע" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="הגדר תדירות להפעלת גיבוי אוטומטי כשהאפליקציה פועלת ברקע במגש המערכת." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,12"/>

                                <StackPanel Margin="0,0,0,12">
                                    <RadioButton Content="ידני בלבד (ללא תזמון אוטומטי)"
                                                 IsChecked="{Binding IsScheduleModeManual}"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 Margin="0,0,0,8"/>
                                    <RadioButton Content="כל שעה (גיבוי תקופתי)"
                                                 IsChecked="{Binding IsScheduleModeHourly}"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="כל יום בשעה מסוימת:"
                                                     IsChecked="{Binding IsScheduleModeDaily}"
                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding DailyScheduleTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70"
                                                 Padding="6,4"
                                                 FontSize="12"
                                                 TextAlignment="Center"
                                                 Background="{DynamicResource AppSurfaceBrush}"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                                 ToolTip="הזן שעה בפורמט HH:mm (לדוגמה 02:00)"
                                                 AutomationProperties.Name="שעת גיבוי יומית"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <RadioButton Content="בעת שינוי בקבצים (ניטור שקט בזמן אמת - FileSystemWatcher)"
                                                 IsChecked="{Binding IsScheduleModeChange}"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 Margin="0,0,0,4"/>
                                </StackPanel>

                                <Border Background="{DynamicResource AppSurfaceHoverBrush}" CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="{Binding ScheduleStatusText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Storage Account -->
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="חשבון אחסון מרוחק (טלגרם מאובטח)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="טוקן הבווט וה-Chat ID מוצפנים ונשמרים ב-Windows DPAPI המאובטח." FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,12"/>

                                <TextBlock Text="Bot Token:" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12"
                                         Background="{DynamicResource AppSurfaceBrush}"
                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         AutomationProperties.Name="טוקן בוט טלגרם"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="Chat ID:" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12"
                                         Background="{DynamicResource AppSurfaceBrush}"
                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         AutomationProperties.Name="מזהה צ'אט טלגרם"
                                         Margin="0,0,0,12"/>

                                <Button Content="בדוק חיבור שרת"
                                        Command="{Binding TestTelegramConnectionCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding SettingsStatusMessage}" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="מצב מערכת: אפס-ידע פעיל | מחובר" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="v1.0.0-beta" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
